#!/bin/bash
#
# valheim-sync — keep a macOS Valheim install in step with the group's
# r2modman profile, and launch it with BepInEx actually attached.
#
#   ./valheim-sync setup      first run on a fresh machine
#   ./valheim-sync sync       pull the latest modpack, repair the install
#   ./valheim-sync play       preflight, then launch
#
set -u -o pipefail

VS_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
PROG="$(basename "$0")"

OPT_GAME_DIR=""
OPT_PROFILE_CODE=""
OPT_PROFILE_NAME=""
OPT_FOREGROUND=0
OPT_FOLLOW=0
OPT_KEEP_CONFIG=0
OPT_NO_CONFIG=0
CMD_ARGS=()

# shellcheck source=lib/common.sh
. "$VS_ROOT/lib/common.sh"
# shellcheck source=lib/profile.sh
. "$VS_ROOT/lib/profile.sh"
# shellcheck source=lib/packages.sh
. "$VS_ROOT/lib/packages.sh"
# shellcheck source=lib/bepinex.sh
. "$VS_ROOT/lib/bepinex.sh"
# shellcheck source=lib/thunderstore.sh
. "$VS_ROOT/lib/thunderstore.sh"
# shellcheck source=lib/preflight.sh
. "$VS_ROOT/lib/preflight.sh"
# shellcheck source=lib/launch.sh
. "$VS_ROOT/lib/launch.sh"

usage() {
	cat <<EOF
${C_BOLD}$PROG${C_RESET} — Valheim modpack sync and launcher for macOS

${C_BOLD}COMMANDS${C_RESET}
  setup            First run: Rosetta, BepInEx, signing, mods, launch options
  sync             Fetch the shared profile, install/update/remove mods,
                   re-apply the loader patches and the ad-hoc signature
  preflight        Check everything and report; changes nothing
  play             Preflight, then launch the game (alias: launch)
  status           What the profile pins versus what is installed
  add MOD...       Add a mod (with its dependencies) without r2modman
  drop MOD...      Remove a mod
  publish          Upload the current mod list and get a code to share
  logs             Show the BepInEx log (the only console macOS gives you)
  steam-options    Print the string to paste into Steam's launch options
  help             This text

${C_BOLD}MOD NAMES${C_RESET}
  Namespace-ModName, Namespace-ModName-1.2.3, Namespace-ModName@1.2.3,
  or a thunderstore.io package URL. Without a version you get the latest.

${C_BOLD}OPTIONS${C_RESET}
  --profile CODE   Use a different r2modman profile code for this run
  --game-dir PATH  Use a different Valheim folder for this run
  --name NAME      publish: name the profile (default: the current one)
  --no-config      publish: mod list only, leave your config out
  --keep-config    sync: leave BepInEx/config alone, mods only
  --foreground     play: run in this terminal instead of detaching
  -f, --follow     logs: tail the log
  -n, --dry-run    Show what would change, change nothing
  -y, --yes        Answer yes to every prompt
  -v, --verbose    Extra detail
  -h, --help       This text

${C_BOLD}CONFIG${C_RESET}
  Shared settings  $(tilde "$VS_ROOT/config.conf")      (commit and share this)
  Local overrides  $(tilde "$LOCAL_CONF")
  State and cache  $(tilde "$STATE_DIR")
EOF
}

# ------------------------------------------------------------------ commands --

cmd_setup() {
	info "Setting up Valheim modding on this Mac"

	if ! is_apple_silicon; then
		dbg "Intel Mac — Rosetta not required"
	elif have_rosetta; then
		ok "Rosetta 2 is installed"
	else
		warn "Rosetta 2 is not installed. BepInEx loads only under x86_64, so"
		warn "the game has to run translated even on an Apple Silicon Mac."
		if confirm "Install Rosetta 2 now?"; then
			install_rosetta || die "Rosetta install failed"
		else
			die "Rosetta 2 is required. Install it with: softwareupdate --install-rosetta --agree-to-license"
		fi
	fi

	[ -d "$APP" ] || die "valheim.app not found in $(tilde "$GAME_DIR") — install Valheim through Steam first"

	cmd_sync || return $?

	printf '\n'
	info "Steam launch options (optional)"
	say "  If you would rather start the game from your Steam library, paste"
	say "  this into Valheim → Properties → Launch Options:"
	printf '\n    %s%s%s\n\n' "$C_BOLD" "$(steam_launch_options)" "$C_RESET"
	say "  Otherwise just run: $PROG play"
	return 0
}

cmd_sync() {
	local rc=0

	info "Fetching profile $PROFILE_CODE"
	fetch_profile || die "could not fetch the profile"
	if [ "$PROFILE_FRESH" -eq 1 ]; then
		ok "profile '$(profile_name)' updated"
	else
		ok "profile '$(profile_name)' unchanged since last sync"
	fi

	info "Checking the BepInEx loader"
	ensure_loader || die "could not prepare the BepInEx loader"
	ok "loader ready, valheim.app signed ad-hoc"

	info "Syncing mods"
	if sync_packages; then
		ok "$SYNC_SUMMARY"
	else
		rc=1
		bad "some mods failed to install — $SYNC_SUMMARY"
	fi

	if [ "$OPT_KEEP_CONFIG" -eq 1 ]; then
		dbg "--keep-config: leaving BepInEx/config untouched"
	else
		info "Applying shared configuration"
		local payload
		payload="$(extract_profile_payload)" || die "could not unpack the profile"
		if sync_profile_config "$payload"; then
			if [ -n "${CONFIG_BACKUP:-}" ]; then
				ok "config applied (previous config saved to $(tilde "$CONFIG_BACKUP"))"
			else
				ok "config applied"
			fi
		else
			rc=1
			bad "could not apply the shared configuration"
		fi
		rm -rf "$payload"
	fi

	return $rc
}

cmd_preflight() {
	preflight
}

cmd_play() {
	preflight
	local rc=$?
	if [ "$rc" -eq 2 ]; then
		die "cannot launch until the problems above are sorted"
	fi
	if [ "$rc" -eq 1 ]; then
		if confirm "Fix these and continue?"; then
			cmd_sync || die "sync failed"
		else
			die "not launching with the install out of step"
		fi
	fi
	ensure_steam
	launch_game "$OPT_FOREGROUND"
}

cmd_status() {
	have_profile || die "no profile cached yet — run: $PROG sync"

	printf '\n%sProfile%s  %s  %s(%s, fetched %s)%s\n\n' \
		"$C_BOLD" "$C_RESET" "$(profile_name)" \
		"$C_DIM" "$PROFILE_CODE" "$(profile_age_human)" "$C_RESET"
	printf "  %-38s %-10s %-10s %-8s %s\n" "MOD" "PINNED" "INSTALLED" "FROM" "STATE"

	local wanted full version origin have state
	wanted="$(mktemp -t vsstatus)"
	desired_mods > "$wanted"

	# The loader packages are in the profile but never installed here.
	profile_enabled_mods | while IFS=$'\t' read -r full version; do
		[ -n "$full" ] || continue
		if is_skipped "$full"; then
			printf '  %-38s %-10s %-10s %-8s %sskipped (macOS loader)%s\n' \
				"$full" "$version" "-" "profile" "$C_DIM" "$C_RESET"
		fi
	done

	while IFS=$'\t' read -r full version origin; do
		[ -n "$full" ] || continue
		is_skipped "$full" && continue
		have="$(installed_version "$full")"
		if [ -z "$have" ]; then
			state="${C_RED}missing${C_RESET}"; have="-"
		elif [ "$have" != "$version" ]; then
			state="${C_YELLOW}out of date${C_RESET}"
		elif [ ! -d "$PLUGINS_DIR/$full" ]; then
			state="${C_RED}files gone${C_RESET}"
		else
			state="${C_GREEN}ok${C_RESET}"
		fi
		printf '  %-38s %-10s %-10s %-8s %b\n' "$full" "$version" "$have" "$origin" "$state"
	done < "$wanted"

	if [ -f "$INSTALLED_TSV" ]; then
		while IFS=$'\t' read -r full version; do
			[ -n "$full" ] || continue
			awk -F'\t' -v n="$full" '$1 == n { f = 1 } END { exit !f }' "$wanted" && continue
			printf '  %-38s %-10s %-10s %-8s %bnot wanted%b\n' \
				"$full" "-" "$version" "-" "$C_YELLOW" "$C_RESET"
		done < "$INSTALLED_TSV"
	fi
	rm -f "$wanted"

	local dropped
	if [ -f "$DROPPED_TXT" ] && [ -s "$DROPPED_TXT" ]; then
		printf '\n  %sdropped locally:%s ' "$C_DIM" "$C_RESET"
		dropped="$(tr '\n' ' ' < "$DROPPED_TXT")"
		printf '%s\n' "$dropped"
	fi
	printf '\n'
}

cmd_add() {
	[ "$#" -gt 0 ] || die "add needs a mod — e.g. $PROG add RustyMods-Seasonality"
	have_profile || fetch_profile || die "could not fetch the profile"

	local spec resolved full version have added=0
	resolved="$(mktemp -t vsadd)"

	for spec in "$@"; do
		info "Resolving $spec"
		ts_resolve "$spec" >> "$resolved" || { rm -f "$resolved"; exit 2; }
	done

	while IFS=$'\t' read -r full version; do
		[ -n "$full" ] || continue
		if is_skipped "$full"; then
			dbg "$full is the Windows loader — skipped on macOS"
			continue
		fi
		have="$(desired_version "$full")"
		# overlay_set runs either way: when the version already matches it is
		# what clears a now-pointless overlay entry or an earlier drop.
		overlay_set "$full" "$version"
		if [ "$have" = "$version" ]; then
			ok "$full $version already in the list"
			continue
		fi
		if [ -n "$have" ]; then
			ok "$full ${have} -> ${version}"
		else
			ok "$full ${version}"
		fi
		added=$((added + 1))
	done < "$resolved"
	rm -f "$resolved"

	if [ "$added" -eq 0 ]; then
		say "  Nothing to change."
		return 0
	fi

	info "Installing"
	ensure_loader || die "could not prepare the BepInEx loader"
	if sync_packages; then
		ok "$SYNC_SUMMARY"
	else
		bad "some mods failed to install — $SYNC_SUMMARY"
		return 1
	fi

	printf '\n'
	say "  Added locally. To hand the group a code with this in it:"
	say "    $PROG publish"
	return 0
}

cmd_drop() {
	[ "$#" -gt 0 ] || die "drop needs a mod — e.g. $PROG drop TenebrisReverie-ResourceBoost"
	have_profile || fetch_profile || die "could not fetch the profile"

	local spec ns name full dropped=0
	for spec in "$@"; do
		IFS=$'\t' read -r ns name _ <<EOF
$(parse_spec "$spec" || true)
EOF
		if [ -z "${ns:-}" ] || [ -z "${name:-}" ]; then
			bad "cannot make sense of '$spec' — expected Namespace-ModName"
			continue
		fi
		full="$ns-$name"
		if [ -z "$(desired_version "$full")" ]; then
			warn "$full is not in the list"
			continue
		fi
		overlay_unset "$full"
		# A drop marker only earns its keep for something the shared profile
		# pins; a purely local mod just leaves the overlay.
		if profile_enabled_mods | awk -F'\t' -v n="$full" '$1 == n { f = 1 } END { exit !f }'; then
			mark_dropped "$full"
		fi
		remove_package "$full"
		ok "removed $full"
		dropped=$((dropped + 1))
	done

	[ "$dropped" -eq 0 ] && return 0
	printf '\n'
	say "  Removed locally. To hand the group a code without it:"
	say "    $PROG publish"
	return 0
}

cmd_publish() {
	have_profile || fetch_profile || die "could not fetch the profile"

	local name="${OPT_PROFILE_NAME:-$(profile_name)}"
	[ -n "$name" ] || name="valheim-sync"

	local with_config=1
	[ "$OPT_NO_CONFIG" -eq 1 ] && with_config=0

	printf '\n%sPublishing profile%s %s\n\n' "$C_BOLD" "$C_RESET" "$name"
	publish_entries | while IFS=$'\t' read -r full version; do
		printf '    %-40s %s\n' "$full" "$version"
	done
	local n; n="$(publish_entries | grep -c . || true)"
	printf '\n  %s mod(s)' "$n"
	[ "$with_config" -eq 1 ] && printf ', plus your BepInEx config'
	printf '\n\n'

	say "  This uploads the list above to Thunderstore and returns a code that"
	say "  anyone can import. The code is public to anyone who has it."
	printf '\n'
	confirm "Upload it?" || { say "  Cancelled."; return 0; }

	local zip; zip="$(mktemp -t vspubzip)"
	build_profile_payload "$name" "$zip" "$with_config" || { rm -f "$zip"; return 1; }
	dbg "payload $(du -h "$zip" | awk '{print $1}')"

	if [ "$OPT_DRY_RUN" -eq 1 ]; then
		printf '  %s[dry-run]%s would upload %s\n' "$C_DIM" "$C_RESET" "$zip"
		rm -f "$zip"
		return 0
	fi

	info "Uploading"
	local key
	key="$(upload_profile "$zip")" || { rm -f "$zip"; return 1; }
	rm -f "$zip"

	printf '\n  %sNew profile code%s\n\n    %s%s%s\n\n' \
		"$C_BOLD" "$C_RESET" "$C_BOLD" "$key" "$C_RESET"
	say "  Share that with the group. On Windows: r2modman -> Import/Update"
	say "  -> Import from code."
	printf '\n'

	if confirm "Make this the shared code in config.conf?"; then
		adopt_profile_code "$key" || return 1
		# Refresh the cached profile before dropping the overlay, or the old
		# cache would silently undo the changes until the next sync.
		PROFILE_CODE="$key"
		if fetch_profile; then
			overlay_clear
			ok "config.conf now pins $key; local changes folded in"
			say "  Commit config.conf so everyone else picks it up."
		else
			warn "config.conf now pins $key, but it could not be fetched yet; local changes kept"
			say "  Run: $PROG sync  (then the overlay can go once the code resolves)"
		fi
	else
		say "  config.conf still pins the old code; your local changes stay local."
	fi
	return 0
}

# adopt_profile_code CODE — rewrite PROFILE_CODE in the shared config file.
adopt_profile_code() {
	local code="$1" tmp
	tmp="$(mktemp -t vscfg)"
	sed "s|^PROFILE_CODE=.*|PROFILE_CODE=\"$code\"|" "$VS_ROOT/config.conf" > "$tmp" || {
		rm -f "$tmp"; bad "could not update config.conf"; return 1
	}
	if ! grep -q "^PROFILE_CODE=\"$code\"" "$tmp"; then
		rm -f "$tmp"; bad "could not find PROFILE_CODE in config.conf"; return 1
	fi
	mv "$tmp" "$VS_ROOT/config.conf"
	# The cached profile is now the wrong one for this code.
	rm -f "$PROFILE_ETAG"
	return 0
}

cmd_steam_options() {
	steam_launch_options
}

cmd_logs() {
	show_logs "$OPT_FOLLOW"
}

# -------------------------------------------------------------------- main --

main() {
	local cmd=""

	while [ $# -gt 0 ]; do
		case "$1" in
			-h|--help)      cmd="help"; shift;;
			-n|--dry-run)   OPT_DRY_RUN=1; shift;;
			-y|--yes)       OPT_YES=1; shift;;
			-v|--verbose)   OPT_VERBOSE=1; shift;;
			-f|--follow)    OPT_FOLLOW=1; shift;;
			--foreground)   OPT_FOREGROUND=1; shift;;
			--keep-config)  OPT_KEEP_CONFIG=1; shift;;
			--no-config)    OPT_NO_CONFIG=1; shift;;
			--profile)      OPT_PROFILE_CODE="${2:-}"; shift 2 || die "--profile needs a code";;
			--game-dir)     OPT_GAME_DIR="${2:-}"; shift 2 || die "--game-dir needs a path";;
			--name)         OPT_PROFILE_NAME="${2:-}"; shift 2 || die "--name needs a value";;
			--profile=*)    OPT_PROFILE_CODE="${1#*=}"; shift;;
			--game-dir=*)   OPT_GAME_DIR="${1#*=}"; shift;;
			--name=*)       OPT_PROFILE_NAME="${1#*=}"; shift;;
			-*)             die "unknown option: $1 (try: $PROG help)";;
			*)              if [ -z "$cmd" ]; then cmd="$1"; else CMD_ARGS+=("$1"); fi; shift;;
		esac
	done

	case "${cmd:-help}" in
		help|"")            usage; return 0;;
	esac

	case "$(uname -s)" in
		Darwin) ;;
		*) die "this tool is macOS-only ($(uname -s) detected)";;
	esac

	load_config

	# Only add/drop take positional arguments.
	case "$cmd" in
		add|drop|remove) ;;
		*) [ "${#CMD_ARGS[@]}" -eq 0 ] || die "$cmd takes no arguments (try: $PROG help)";;
	esac

	case "$cmd" in
		setup)                    cmd_setup;;
		sync|update)              cmd_sync;;
		preflight|check|doctor)   cmd_preflight;;
		play|launch|start)        cmd_play;;
		status)                   cmd_status;;
		add)                      cmd_add "${CMD_ARGS[@]+"${CMD_ARGS[@]}"}";;
		drop|remove)              cmd_drop "${CMD_ARGS[@]+"${CMD_ARGS[@]}"}";;
		publish|share)            cmd_publish;;
		logs|log)                 cmd_logs;;
		steam-options|steam)      cmd_steam_options;;
		*) die "unknown command: $cmd (try: $PROG help)";;
	esac
}

main "$@"
